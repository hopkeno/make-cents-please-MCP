# Copy this file to .env and fill in your values. .env is git-ignored.

# Required unless YNAB_TOOLS=off. Create one at https://app.ynab.com/settings/developer
YNAB_ACCESS_TOKEN=

# Optional. Plan (budget) used when a tool call omits plan_id.
# Defaults to YNAB's "last-used" plan. Run the list_plans tool to find ids.
YNAB_DEFAULT_PLAN_ID=

# Optional. Seconds cached responses are considered fresh (default 300).
YNAB_CACHE_TTL_SECONDS=300

# Optional. Log level for messages written to stderr (default WARNING).
LOG_LEVEL=WARNING

# Optional. Set to off to hide the ynab_* tools, e.g. when you use YNAB's own MCP server
# for YNAB. Charity Record tools stay available. With it off, YNAB_ACCESS_TOKEN is only
# needed for charityrecord_find_ynab_donations and charityrecord_reconcile. Default on.
YNAB_TOOLS=on

# Optional. Set to true to enable tools that create, change or delete YNAB data.
# Every write still needs a preview and an explicit confirmation. Default false.
YNAB_ALLOW_WRITES=false

# Optional. Folder for Charity Record CSV files: put your exports here, and generated
# import files are written here. Leave empty to turn the Charity Record tools off.
CHARITYRECORD_DIR=
